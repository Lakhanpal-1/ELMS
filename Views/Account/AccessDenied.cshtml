@{
    ViewData["Title"] = "Access Denied";
}

<div class="card" style="max-width: 580px; margin: 4rem auto;">
    <div class="card-body" style="text-align:center; padding: 2.5rem;">
        <div class="empty-icon" style="background: var(--danger-soft); color: var(--danger); width:72px; height:72px; margin: 0 auto 1.25rem; display:grid; place-items:center; border-radius:50%; font-size:1.75rem;">
            <i class="fas fa-lock"></i>
        </div>
        <h2>Access denied</h2>
        <p class="text-muted">You don't have permission to view this page. If you think this is a mistake, contact your administrator.</p>
        <div class="form-actions" style="justify-content:center; border:0; padding-top:1.5rem; margin-top:1rem;">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-gauge-high"></i> Back to Dashboard
            </a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-right-from-bracket"></i> Sign out
            </a>
        </div>
    </div>
</div>
