@model List<LeaveRequest>
@{
    ViewData["Title"] = "Pending Leave Requests";
}

<div class="page-header-row">
    <div>
        <h1>Pending Leave Requests</h1>
        <p class="subtitle">Approve or reject employee leave applications.</p>
    </div>
    <span class="badge @(Model.Count == 0 ? "bg-success" : "bg-warning")" style="font-size:.78rem; padding:.5rem .85rem;">
        <i class="fas @(Model.Count == 0 ? "fa-check" : "fa-clock")"></i>
        @Model.Count awaiting decision
    </span>
</div>

@if (!Model.Any())
{
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card">
                <div class="empty-state" style="padding:3.5rem 1.5rem;">
                    <div class="empty-icon"><i class="fas fa-circle-check"></i></div>
                    <h5>All caught up</h5>
                    <p>There are no pending leave requests right now. New applications will appear here as soon as employees submit them.</p>
                    <div class="empty-actions">
                        <a asp-controller="LeaveRequest" asp-action="Index" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-file-lines"></i> View all requests
                        </a>
                        <a asp-controller="Employee" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-users"></i> Manage employees
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card mb-3">
                <div class="card-header">
                    <h5><i class="fas fa-lightbulb"></i> Approval workflow</h5>
                </div>
                <ul class="activity-list">
                    <li class="activity-item">
                        <div class="activity-dot info"><i class="fas fa-paper-plane"></i></div>
                        <div class="activity-body">
                            <div class="who">1. Employee applies</div>
                            <div class="what">Submits a leave request from their dashboard.</div>
                        </div>
                    </li>
                    <li class="activity-item">
                        <div class="activity-dot warning"><i class="fas fa-hourglass-half"></i></div>
                        <div class="activity-body">
                            <div class="who">2. Awaits review</div>
                            <div class="what">Appears on this screen with the requested dates and reason.</div>
                        </div>
                    </li>
                    <li class="activity-item">
                        <div class="activity-dot success"><i class="fas fa-check"></i></div>
                        <div class="activity-body">
                            <div class="who">3. You decide</div>
                            <div class="what">Approve or reject — the employee is notified and balances update automatically.</div>
                        </div>
                    </li>
                </ul>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-bolt"></i> Shortcuts</h5>
                </div>
                <div class="card-body" style="padding:1rem;">
                    <div class="quick-actions" style="grid-template-columns:1fr;">
                        <a asp-controller="LeaveRequest" asp-action="Index" class="quick-action">
                            <i class="fas fa-file-lines"></i>
                            <span class="label">All leave requests<span class="sub">Full audit trail</span></span>
                        </a>
                        <a asp-controller="LeaveType" asp-action="Index" class="quick-action">
                            <i class="fas fa-tags"></i>
                            <span class="label">Leave type catalog<span class="sub">Manage policies</span></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var r in Model)
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row g-3 align-items-start">
                            <div class="col-md-4">
                                <div style="font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted); font-weight:600; margin-bottom:.25rem;">Employee</div>
                                <div style="font-weight:600; font-size:1.05rem;">
                                    <a asp-action="Details" asp-route-id="@r.LeaveRequestId">@r.Employee?.FullName</a>
                                </div>
                                <div class="text-muted" style="font-size:.85rem;">@r.Employee?.Department?.DepartmentName</div>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted); font-weight:600; margin-bottom:.25rem;">Leave</div>
                                <div style="font-weight:500;">@r.LeaveType?.Name &nbsp;·&nbsp; <span class="badge bg-light">@r.NumberOfDays days</span></div>
                                <div class="text-muted" style="font-size:.85rem;">
                                    <i class="fas fa-calendar"></i> @r.StartDate.ToShortDateString() &mdash; @r.EndDate.ToShortDateString()
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted); font-weight:600; margin-bottom:.25rem;">Reason</div>
                                <div class="text-muted" style="font-size:.9rem;">@(string.IsNullOrWhiteSpace(r.Reason) ? "—" : r.Reason)</div>
                            </div>
                        </div>
                        <hr />
                        <form asp-action="Approve" method="post" style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:center;">
                            <input type="hidden" name="id" value="@r.LeaveRequestId" />
                            <input type="text" name="remarks" class="form-control form-control-sm" placeholder="Remarks (optional)" style="flex:1; min-width:200px;" />
                            <button type="submit" class="btn btn-sm btn-success"><i class="fas fa-check"></i> Approve</button>
                            <button type="submit" formaction="@Url.Action("Reject", "LeaveRequest")" class="btn btn-sm btn-danger"><i class="fas fa-xmark"></i> Reject</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
