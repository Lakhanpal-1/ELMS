@{
    ViewData["Title"] = "Welcome";
    Layout = "_Layout";
}

<div class="auth-shell">
    <aside class="auth-side">
        <div class="auth-side-inner">
            <a href="@Url.Action("Index","Home")" class="brand">
                <i class="fas fa-calendar-check"></i> ELMS
            </a>
            <h2>Time off, made simple.</h2>
            <p>Apply for leave, track balances, and approve requests — all in one streamlined workspace for your team.</p>
            <ul class="features">
                <li><i class="fas fa-check"></i> Real-time leave balances & approvals</li>
                <li><i class="fas fa-check"></i> Role-based dashboards for HR and staff</li>
                <li><i class="fas fa-check"></i> Clean audit trail on every request</li>
            </ul>
        </div>
        <div class="meta">&copy; @DateTime.Now.Year Employee Leave Management System</div>
    </aside>

    <section class="auth-main">
        <div class="auth-card" style="max-width: 560px;">
            <div class="auth-brand-mobile">
                <i class="fas fa-calendar-check"></i> ELMS
            </div>
            <span class="badge bg-primary" style="margin-bottom: 1rem;">Welcome</span>
            <h2>Employee Leave Management</h2>
            <p class="auth-sub">Sign in to apply for leave or manage your team's requests.</p>

            <div style="display:flex; gap:.6rem; flex-wrap:wrap; margin-bottom: 2rem;">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">
                    <i class="fas fa-arrow-right-to-bracket"></i> Login
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-user-plus"></i> Register
                </a>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card feature-card">
                        <div class="feature-ico"><i class="fas fa-paper-plane"></i></div>
                        <h5 class="card-title">Apply for Leave</h5>
                        <p class="text-muted mb-0">Pick a leave type and dates — balances are checked automatically.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card feature-card">
                        <div class="feature-ico"><i class="fas fa-chart-line"></i></div>
                        <h5 class="card-title">Track Status</h5>
                        <p class="text-muted mb-0">See every request — Pending, Approved or Rejected — with remarks.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card feature-card">
                        <div class="feature-ico"><i class="fas fa-shield-halved"></i></div>
                        <h5 class="card-title">HR Control</h5>
                        <p class="text-muted mb-0">Manage employees, departments and approvals from one dashboard.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
