@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card" style="max-width: 640px; margin: 3rem auto;">
    <div class="card-body" style="text-align:center; padding: 2.5rem;">
        <div class="empty-icon" style="background: var(--danger-soft); color: var(--danger); width:72px; height:72px; margin: 0 auto 1.25rem; display:grid; place-items:center; border-radius:50%; font-size:1.75rem;">
            <i class="fas fa-triangle-exclamation"></i>
        </div>
        <h2>Something went wrong</h2>
        <p class="text-muted">An unexpected error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p class="mb-0"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <div class="form-actions" style="justify-content:center; border:0; padding-top:1.5rem; margin-top:1rem;">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-house"></i> Back to Home
            </a>
        </div>
    </div>
</div>
