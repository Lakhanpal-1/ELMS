@model Employee
@{
    ViewData["Title"] = "Delete Employee";
}

<div class="page-header">
    <h1 style="color: var(--danger);">Delete Employee</h1>
    <p class="subtitle">This action cannot be undone.</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="fas fa-triangle-exclamation"></i>
                    <span>Deleting this employee will also remove their login account and leave history.</span>
                </div>
                <p>Are you sure you want to delete <strong>@Model.FullName</strong> (@Model.Email)?</p>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="EmployeeId" />
                    <div class="form-actions">
                        <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Delete Employee</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
