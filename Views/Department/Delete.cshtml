@model Department
@{
    ViewData["Title"] = "Delete Department";
}

<div class="page-header">
    <h1 style="color: var(--danger);">Delete Department</h1>
    <p class="subtitle">This action cannot be undone.</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <p>Are you sure you want to delete <strong>@Model.DepartmentName</strong>?</p>
                @if (Model.Employees != null && Model.Employees.Any())
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-triangle-exclamation"></i>
                        <span>This department still has @Model.Employees.Count employee(s) assigned. Reassign or remove them before deleting.</span>
                    </div>
                }
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="DepartmentId" />
                    <div class="form-actions">
                        <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Delete</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
