@model Department
@{
    ViewData["Title"] = "New Department";
}

<div class="page-header">
    <h1>New Department</h1>
    <p class="subtitle">Add a department to your organization.</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="form-section">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex")"></div>
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="DepartmentName" class="form-label"></label>
                    <input asp-for="DepartmentName" class="form-control" autofocus placeholder="e.g. Engineering" />
                    <span asp-validation-for="DepartmentName" class="text-danger"></span>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk"></i> Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
