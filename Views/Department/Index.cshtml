@model List<Department>
@{
    ViewData["Title"] = "Departments";
}

<div class="page-header-row">
    <div>
        <h1>Departments</h1>
        <p class="subtitle">Organize and manage company departments.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> New Department
    </a>
</div>

<div class="card">
    <div class="card-body" style="padding:0;">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fas fa-sitemap"></i></div>
                <h5>No departments yet</h5>
                <p><a asp-action="Create">Create your first department</a> to organize your team.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Department</th>
                            <th>Employees</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td><strong>@d.DepartmentName</strong></td>
                                <td><span class="badge bg-light"><i class="fas fa-user"></i> @(d.Employees?.Count ?? 0) employees</span></td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@d.DepartmentId" class="btn btn-sm btn-outline-secondary"><i class="fas fa-pen"></i></a>
                                    <a asp-action="Delete" asp-route-id="@d.DepartmentId" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
